{
  "name": "@myghf/ui",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/myghf/ui.git"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./tailwind-preset": {
      "import": "./dist/tailwindPreset.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && cp src/tokens.css src/tailwindPreset.js dist/",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "changeset": "changeset",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@internationalized/date": "^3.8.0",
    "@tanstack/vue-table": "^9.2.4",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^0.525.0",
    "reka-ui": "^2.2.0",
    "tailwind-merge": "^3.3.1",
    "tailwind-variants": "^1.0.0"
  },
  "peerDependencies": {
    "tailwindcss": "^3.4.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^30.1.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.10",
    "vue": "^3.5.39",
    "vue-tsc": "^3.3.5"
  }
}
